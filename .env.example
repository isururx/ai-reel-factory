# Backend-only environment variables. Never commit your real .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
FRONTEND_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# M6 LLM provider (backend only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# NVIDIA NIM multimodal video-analysis fallback (backend only)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_ANALYSIS_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional OpenAI-compatible provider configuration for future switching
LLM_API_KEY=
LLM_BASE_URL=
