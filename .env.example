# Backend-only environment variables. Never commit your real .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
FRONTEND_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=


# M6 LLM provider (backend only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
QWEN_API_KEY=
# Optional: set your Alibaba Model Studio Singapore workspace endpoint
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_ANALYSIS_MODEL=qwen3.8-flash
# Optional OpenAI-compatible provider configuration for future switching
LLM_API_KEY=
LLM_BASE_URL=
